  m_Name: Pteranodon
  m_EditorClassIdentifier: 
  dinoName: "\uD504\uD14C\uB77C\uB178\uB3C8"
  description: "\uBC31\uC545\uAE30 \uD6C4\uAE30 \uBD81\uC544\uBA54\uB9AC\uCE74\uC5D0\uC11C
    \uC0B4\uC558\uB358 \uC775\uB8E1\uC774\uBA70 '\uC774\uBE68\uC5C6\uB294 \uB0A0\uAC1C'\uB77C\uB294
    \uB73B\uC758 \uC774\uB984\uC744 \uAC00\uC9C0\uACE0 \uC788\uB2E4. \uBA38\uB9AC\uC5D0
    \uAE34 \uBCCF\uC774 \uC788\uB294 \uAC83\uC774 \uD2B9\uC9D5\uC774\uB2E4. \uC775\uB8E1\uC911\uC5D0\uC11C\uB294
    \uD070\uD3B8\uC5D0 \uC18D\uD558\uC9C0\uB9CC, \uBAB8\uBB34\uAC8C\uB294 \uCD5C\uB300
    50kg \uB0A8\uC9D3\uC73C\uB85C \uB9E4\uC6B0 \uAC00\uBCBC\uC6B4 \uD3B8\uC774\uB2E4.
    \uC55E\uBC1C\uC740 \uC808\uBCBD\uC5D0 \uB9E4\uB2EC\uB9AC\uAE30 \uC88B\uC740 \uAC08\uACE0\uB9AC
    \uBAA8\uC591\uC744 \uD558\uACE0 \uC788\uC73C\uBA70, \uC18D\uBA85\uC5D0\uC11C
    \uC784 \u3163\uC5B8\uAE09\uD55C \uAC83\uCC98\uB7FC \uC774\uBE68\uC774 \uC5C6\uB294
    \uBD80\uB9AC\uB97C \uAC00\uC9C0\uACE0 \uC788\uB2E4. "
