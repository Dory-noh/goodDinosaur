  dinoName: "\uB51C\uB85C\uD3EC\uC0AC\uC6B0\uB8E8\uC2A4 "
  description: "\uC950\uB77C\uAE30 \uC804\uAE30 \uBD81\uC544\uBA54\uB9AC\uCE74\uC5D0\uC11C
    \uC11C\uC2DD\uD558\uB358 \uC218\uAC01\uB958 \uACF5\uB8E1. '\uBCCF\uC774 \uB450
    \uAC1C\uC778 \uB3C4\uB9C8\uBC40'\uC774\uB77C\uB294 \uB73B. \uBF08\uB85C \uB418\uC5B4
    \uC788\uB294 \uBCCF \uD55C \uC30D\uC774 \uBA38\uB9AC\uC5D0 \uB098 \uC788\uB294\uAC83\uC774
    \uD2B9\uC9D5\uC774\uB2E4. \uC950\uB77C\uAE30 \uC804\uAE30\uC5D0 \uC911\uD615
    \uD06C\uAE30\uC758 \uC721\uC2DD\uACF5\uB8E1\uC774\uC5C8\uC744 \uAC83\uC73C\uB85C
    \uCD94\uC815\uD55C\uB2E4.  \uC601\uD654 '\uC950\uB77C\uAE30 \uACF5\uC6D0'\uC5D0\uC11C
    \uBAA9\uB3C4\uB9AC \uB3C4\uB9C8\uBC40\uACFC \uBE44\uC2B7\uD55C \uBAA8\uC2B5\uC73C\uB85C
    \uB098\uC628 \uAC83\uC73C\uB85C \uC778\uC9C0\uB3C4\uAC00 \uC0DD\uACBC\uB2E4. "
