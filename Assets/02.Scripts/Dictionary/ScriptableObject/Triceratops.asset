  m_Name: Triceratops
  m_EditorClassIdentifier: 
  dinoName: "\uD2B8\uB9AC\uCF00\uB77C\uD1B1\uC2A4"
  description: "\uBC31\uC545\uAE30 \uD6C4\uAE30\uC5D0 \uBD81\uC544\uBA54\uB9AC\uCE74\uC5D0\uC11C
    \uBC1C\uACAC\uB41C \uAC01\uB8E1\uB958 \uACF5\uB8E1. \uD559\uBA85\uC740 '\uC138
    \uAC1C\uC758 \uBFD4\uC774 \uB2EC\uB9B0 \uC5BC\uAD74'\uC774\uB780 \uB73B\uC774\uB2E4.
    \uCF54 \uBD80\uBD84\uC5D0 \uD55C \uAC1C, \uB208 \uC704\uCB49\uC5D0 \uD06C\uAC8C
    \uB450 \uAC1C\uAC00 \uB098 \uC788\uC73C\uBA70, \uC774\uB294 \uCC9C\uC801\uC744
    \uBB3C\uB9AC\uCE58\uB294 \uC6A9\uB3C4\uC640 \uACFC\uC2DC \uC6A9\uB3C4 \uB4F1\uC73C\uB85C
    \uC0AC\uC6A9\uB418\uC5C8\uC744 \uAC83\uC73C\uB85C \uC608\uC0C1\uB41C\uB2E4. \uB450\uAC1C\uACE8
    \uB4A4\uCABD\uC5D0 \uD310\uCC98\uB7FC \uAE38\uAC8C \uBCCF\uC774 \uC788\uB294\uB370,
    \uC774\uB97C \uD504\uB9B4\uC774\uB77C\uACE0 \uBD80\uB978\uB2E4. "
