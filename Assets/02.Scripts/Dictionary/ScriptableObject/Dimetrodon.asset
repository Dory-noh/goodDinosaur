  dinoName: "\uB514\uBA54\uD2B8\uB85C"
  description: "\uD398\uB984\uAE30 \uC804\uAE30\uC5D0\uC11C \uC544\uBA54\uB9AC\uCE74\uC5D0
    \uC0B4\uC558\uB358 \uBC18\uB8E1\uB958. \uC774\uB984\uC740 '\uB450 \uC885\uB958\uC758
    \uC774\uBE68'\uC774\uB77C\uB294 \uB73B. \uACF5\uB8E1\uACFC \uC720\uC0AC\uD558\uAC8C
    \uC0DD\uACBC\uC9C0\uB9CC, \uACF5\uB8E1\uC774 \uC544\uB2CC \uB2E8\uAD81\uB958\uB85C
    \uBD84\uB958\uB418\uB294 \uC0DD\uBB3C\uCCB4. \uB4F1\uC5D0 \uB09C \uCEE4\uB2E4\uB780
    \uC2E0\uACBD\uBC30\uB3CC\uAE30\uB85C \uBC88\uC2DD\uC5D0\uC11C\uC758 \uACFC\uC2DC,
    \uACBD\uC7C1\uC0C1\uB300\uB97C \uC704\uD611\uD558\uB294\uB370 \uC4F0\uC600\uC744
    \uAC83\uC73C\uB85C \uC608\uC0C1\uD558\uACE0 \uC788\uB2E4. "
