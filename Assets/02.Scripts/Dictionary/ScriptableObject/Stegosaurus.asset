  m_Script: {fileID: 11500000, guid: b7e6e8dfc9d977749a5c5a308b781c4c, type: 3}
  m_Name: Stegosaurus
  m_EditorClassIdentifier: 
  dinoName: "\uC2A4\uD14C\uACE0\uC0AC\uC6B0\uB8E8\uC2A4"
  description: "\uC950\uB77C\uAE30 \uD6C4\uAE30 \uC544\uBA54\uB9AC\uCE74\uC758 \uBBF8\uAD6D\uACFC
    \uC720\uB7FD \uD3EC\uB974\uD2B8\uAD74\uC5D0 \uC0B4\uC558\uB358 \uAC80\uB8E1\uB958
    \uACF5\uB8E1. \uC774\uB984\uC740 '\uC9C0\uBD95 \uB3C4\uB9C8\uBC40'\uC774\uB77C\uB294
    \uB73B\uC774\uB2E4. \uBA38\uB9AC\uC5D0\uC11C \uAF2C\uB9AC\uB85C \uAC08 \uC218\uB85D
    \uBAB8\uC758 \uB192\uC774\uAC00 \uD06C\uAC8C \uC19F\uC544 \uC62C\uB77C\uAC00\uB294
    \uD2B9\uC9D5\uC744 \uAC00\uC84C\uACE0, \uB4F1\uC744 \uB530\uB77C \uB098 \uC788\uB294
    \uBF08\uB294 \uACE8\uD310\uC774\uB77C\uACE0 \uBD80\uB974\uB294\uB370 \uC815\uD655\uD55C
    \uC6A9\uB3C4\uB294 \uC544\uC9C1 \uC54C \uC218 \uC5C6\uB2E4\uACE0 \uD558\uBA70,
    \uAF2C\uB9AC\uCABD\uC5D0 \uB098 \uC788\uB294 \uACE8\uCE68\uC774\uB77C\uACE0 \uBD88\uB9AC\uB294
    \uBF08\uB294 \uCC9C\uC801\uC744 \uBB3C\uB9AC\uCE58\uB294 \uC6A9\uB3C4\uB85C \uC0AC\uC6A9\uD588\uC744
    \uAC83\uC73C\uB85C \uC608\uC0C1\uB41C\uB2E4. "
