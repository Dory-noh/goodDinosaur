  dinoName: "\uC624\uBE44\uB78D\uD1A0\uB974"
  description: "\uBC31\uC545\uAE30 \uD6C4\uAE30 \uBABD\uACE8\uC5D0\uC11C \uC11C\uC0AD\uD55C
    \uC218\uAC01\uB958\uC758 \uC77C\uC885. \uC774\uB984\uC758 \uB73B\uC740 '\uC54C
    \uB3C4\uB451'\uC774\uB2E4. \uCCAB \uBC1C\uACAC\uC774 \uD504\uB85C\uD1A0\uCF00\uB77C\uD1B1\uC2A4\uC758
    \uC54C \uD654\uC11D \uC606\uC5D0\uC11C \uBC1C\uACAC\uB418\uC5B4 \uC774\uB7F0
    \uD559\uBA85\uC744 \uC5BB\uAC8C \uB418\uC5C8\uC73C\uB098, \uD604\uB300\uC758
    \uC870\uB958\uAC00 \uC54C\uC744 \uD488\uB294 \uB4EF \uC54C\uC744 \uD488\uACE0
    \uC788\uB294 \uBAA8\uC2B5\uC758 \uD654\uC11D\uC774 \uBC1C\uACAC\uB418\uC5B4 \uC54C
    \uB3C4\uB451\uC774\uB77C\uB294 \uC624\uBA85\uC744 \uBC97\uAC8C \uB418\uC5C8\uB2E4.
    \uB450\uC0C1\uC774 \uC870\uB958\uC640 \uB9E4\uC6B0 \uD761\uC0AC\uD558\uBA70 \uBD80\uB9AC\uC640
    \uAC19\uC740 \uC785\uC744 \uAC00\uC9C0\uACE0 \uC788\uB294 \uBAA8\uC2B5\uC73C\uB85C
    \uC608\uC0C1\uD55C\uB2E4. "
