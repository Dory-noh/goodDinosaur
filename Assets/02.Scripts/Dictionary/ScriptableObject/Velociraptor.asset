  dinoName: "\uBCA8\uB85C\uD0A4\uB78D\uD1A0\uB974"
  description: "\uBC31\uC545\uAE30 \uD6C4\uAE30 \uB3D9\uC544\uC2DC\uC544\uC5D0 \uC11C\uC2DD\uD588\uB358
    \uC218\uAC01\uB958. \uC774\uB984\uC758 \uC720\uB798\uB294 '\uB0A0\uC318 \uB3C4\uB451'\uC774\uB77C\uB294
    \uB73B. \uB4B7\uAC08\uACE0\uB9AC \uBC1C\uD1B1\uC740 \uB0AB \uBAA8\uC591\uC73C\uB85C
    \uAD6C\uBD80\uB7EC\uC838 \uC788\uB294\uB370, \uC774\uB97C \uC0AC\uB0E5\uC5D0\uC11C
    \uC0AC\uC6A9\uD588\uC744 \uAC83\uC744 \uCD94\uC815\uB41C\uB2E4. \uD604\uB300\uC5D0
    \uC640\uC11C\uB294 \uAE43\uD138\uC758 \uD754\uC801\uB4E4\uC774 \uBC1C\uACAC\uB418\uBA74\uC11C
    \uC774\uC804\uC5D0 \uB9E4\uB048\uD55C \uBAB8\uC774 \uC544\uB2CC, \uD761\uC0AC
    \uB9F9\uAE08\uB958\uC640 \uBE44\uC2B7\uD55C \uC0DD\uAE40\uC0C8\uB85C \uBCF5\uC6D0\uB3C4\uAC00
    \uADF8\uB824\uC9C4\uB2E4."
