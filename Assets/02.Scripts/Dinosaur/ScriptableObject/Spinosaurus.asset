  m_Script: {fileID: 11500000, guid: b7e6e8dfc9d977749a5c5a308b781c4c, type: 3}
  m_Name: Spinosaurus
  m_EditorClassIdentifier: 
  dinoName: "\uC2A4\uD53C\uB178\uC0AC\uC6B0\uB8E8\uC2A4 "
  description: "\uBC31\uC545\uAE30 \uD6C4\uAE30 \uBD81\uC544\uBA54\uB9AC\uCE74\uC5D0\uC11C
    \uC11C\uC2DD\uD588\uB358 \uC218\uAC01\uB958 \uACF5\uB8E1. \uC18D\uBA85\uC740
    '\uCC99\uCD94 \uB3C4\uB9C8\uBC40'\uC774\uB77C\uB294 \uB73B\uC774\uB2E4. \uBAB8\uAE38\uC774\uAC00
    \uCD5C\uC7A5\uC778 \uC218\uAC01\uB958 \uACF5\uB8E1\uC774\uBA70 \uC778\uC9C0\uB3C4\uAC00
    \uB192\uC740 \uACF5\uB8E1\uC774\uC9C0\uB9CC, \uC804\uC2E0 \uD654\uC11D\uC774
    \uBC1C\uACAC\uB418\uC9C0 \uC54A\uC544 \uC815\uD655\uD55C \uBCF5\uC6D0\uB3C4\uAC00
    \uC5C6\uB294 \uD3B8\uC774\uBA70 \uC5EC\uB7EC\uAC00\uC9C0 \uCD94\uCE21\uC774 \uB098\uC624\uACE0
    \uC788\uB2E4. \uB2E4\uB978 \uC721\uC0C1\uB3D9\uBB3C\uB4E4\uC5D0 \uBE44\uD574
    \uACE8\uBC00\uB3C4\uAC00 \uB192\uC558\uB294\uB370, \uC774\uB97C \uD1B5\uD574
    \uBC18\uC218\uC0DD \uB3D9\uBB3C\uB85C \uCD94\uCE21\uD558\uAE30\uB3C4 \uD558\uBA70,
    \uB4F1\uC5D0\uB294 \uD06C\uAC8C \uC2E0\uACBD\uBC30\uB3CC\uAE30\uAC00 \uB098\uC788\uB2E4. "
