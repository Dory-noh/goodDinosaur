  dinoName: "\uBE0C\uB77C\uD0A4\uC624\uC0AC\uC6B0\uB8E8\uC2A4"
  description: "\uC950\uB77C\uAE30 \uD6C4\uAE30 \uBD81\uC544\uBA54\uB9AC\uCE74\uC5D0
    \uC0B4\uC558\uB358 \uC6A9\uAC01\uB958 \uACF5\uB8E1. '\uD314 \uB3C4\uB9C8\uBC40'\uC774\uB77C\uB294
    \uB73B\uC73C\uB85C \uC55E\uB2E4\uB9AC\uAC00 \uB4B7\uB2E4\uB9AC\uBCF4\uB2E4 \uAE38\uC5B4\uC11C
    \uBD99\uC5EC\uC9C4 \uD559\uBA85\uC774\uB2E4. \uC55E\uBC1C\uC774 \uB9E4\uC6B0
    \uAE38\uBA70 \uB192\uC740 \uC5B4\uAE68 \uC704\uB85C \uBED7\uC740 \uAE34 \uBAA9\uC740
    \uAE30\uB9B0\uCC98\uB7FC \uB192\uC740 \uACF3\uC5D0 \uB098 \uC788\uB294 \uC2DD\uBB3C\uC744
    \uBA39\uC744 \uC218 \uC788\uAC8C \uB3C4\uC640\uC8FC\uC5C8\uB2E4\uACE0 \uD55C\uB2E4.
    \uBAB8 \uAE38\uC774\uB294 18m\uC5D0\uC11C 22m \uC815\uB3C4\uB85C, \uB2F9\uC2DC\uC5D0
    \uACF5\uC874\uD588\uB358 \uACF5\uB8E1\uB4E4\uC911\uC5D0\uC11C \uAC00\uC7A5 \uD070\uD3B8\uC774\uC5C8\uB2E4\uACE0
    \uC608\uC0C1\uD55C\uB2E4. "
