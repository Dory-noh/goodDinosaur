  dinoName: "\uD30C\uB77C\uC0AC\uC6B0\uB8F0\uB8E8\uD478\uC2A4"
  description: "\uBC31\uC545\uAE30 \uD6C4\uAE30 \uBD81\uC544\uBA54\uB9AC\uCE74\uC5D0
    \uC11C\uC2DD\uD588\uB358 \uACF5\uB8E1. \uC18D\uBA85\uC758 \uB73B\uC740 '\uB3C4\uB9C8\uBC40
    \uBCCF'\uC774\uB2E4. \uC624\uB9AC\uCC98\uB7FC \uB0A9\uC791\uD55C \uC785\uC744
    \uAC00\uC84C\uACE0, \uBA38\uB9AC \uB4A4\uD3B8\uC5D0 1m \uAE38\uC774\uC758 \uAD6C\uBD80\uB7EC\uC9C4
    \uBCCF\uC774 \uB098 \uC788\uB2E4. \uC5B4\uB9B4\uB54C\uC5D4 \uD639\uACFC \uAC19\uC740
    \uC678\uD615\uC774\uC9C0\uB9CC, \uC790\uB77C\uBA74\uC11C \uB354 \uAE38\uC5B4\uC9C0\uACE0
    \uCEE4\uC9C4\uB2E4\uACE0 \uD55C\uB2E4. \uBCCF\uC774 \uC5B4\uB5A4 \uC5ED\uD560\uC744
    \uD588\uB294\uC9C0\uB294 \uC5EC\uB7EC \uAC00\uC124\uC774 \uC788\uB294\uB370,
    \uACF5\uBA85\uAD00\uC758 \uC5ED\uD560\uC744 \uD558\uAC70\uB098 \uC2E0\uD638\uB97C
    \uBCF4\uB0B4\uB294 \uAE30\uAD00\uC774 \uC544\uB2C8\uC5C8\uC744\uAE4C \uCD94\uCE21\uD55C\uB2E4. "
