  dinoName: "\uC548\uD0AC\uB85C\uC0AC\uC6B0\uB8E8\uC2A4"
  description: "\uBC31\uC545\uAE30 \uD6C4\uAE30 \uBD81\uC544\uBA54\uB9AC\uCE74 \uC870\uBC18\uBAA9
    \uCD08\uC2DD\uACF5\uB8E1. \uC774\uB984\uC758 \uB73B\uC740 '\uC735\uD569\uB41C
    \uB3C4\uB9C8\uBC40'\uC774\uB77C\uB294 \uB73B\uC774\uB2E4. \uBAB8\uC5D0 \uCD18\uCD18\uD558\uAC8C
    \uACE8\uD3B8\uC774 \uB098 \uC788\uC73C\uBA70, \uC774\uB294 \uAC11\uC637\uCC98\uB7FC
    \uCC9C\uC801\uC73C\uB85C\uBD80\uD130 \uBCF4\uD638\uD558\uAE30 \uC704\uD55C \uAC11\uC637\uCC98\uB7FC
    \uC791\uC6A9\uD588\uC744 \uAC83\uC73C\uB85C \uCD94\uC815. \uAF2C\uB9AC \uB05D\uC5D0
    \uBF08\uB85C \uB41C \uCEE4\uB2E4\uB780 \uB369\uC5B4\uB9AC\uAC00 \uC788\uB294\uB370,
    \uC774\uB294 \uACE4\uBD09\uCC98\uB7FC \uD718\uB450\uB974\uBA70 \uC801\uC758 \uC811\uADFC\uC73C\uB85C\uBD80\uD130
    \uBC29\uC5B4\uD588\uC744 \uAC83\uC73C\uB85C \uC608\uC0C1\uD55C\uB2E4. "
